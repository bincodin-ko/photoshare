{
  "name": "@photoshare/cli",
  "version": "0.1.0",
  "description": "Convert between iPhone Live Photos and Galaxy/Pixel Motion Photos from the command line.",
  "type": "module",
  "bin": { "photoshare": "./dist/bin.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@photoshare/core": "workspace:*",
    "jpeg-js": "^0.4.4",
    "libheif-js": "^1.23.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
